# ─── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (Project Settings → API) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer either ANON_KEY (legacy JWT) or PUBLISHABLE_KEY (new dashboard name)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key
# New dashboard may label this as "secret" — either name works in our code:
# SUPABASE_SECRET_KEY=sb_secret_...

# Local Windows only — if login fails with UNABLE_TO_VERIFY_LEAF_SIGNATURE
SUPABASE_INSECURE_TLS=1

# Database password (Settings → Database) — enables `npm run db:migrate` from this repo
# You only set this once; never paste SQL by hand again.
SUPABASE_DB_PASSWORD=your-database-password
# Or full URL instead of password:
# DATABASE_URL=postgresql://postgres:...@db.xxxxx.supabase.co:5432/postgres

# Optional: extra pepper for hashing password-reset OTP codes
AUTH_OTP_PEPPER=long-random-string

# ─── Resend (password reset + order emails) ─────────────
RESEND_API_KEY=re_xxxxxxxx
# Verified domain sender (resend.com/domains → velvetshell.in)
RESEND_FROM_EMAIL=Velvet Shell <sales@velvetshell.in>
# Owner inbox for “new order received” / shipped / delivered (falls back to ADMIN_EMAIL)
ORDERS_NOTIFY_EMAIL=info.velvetshell@gmail.com
RESEND_TO_OWNER=info.velvetshell@gmail.com
GIFTING_NOTIFY_EMAIL=info.velvetshell@gmail.com

# ─── Delhivery One (B2C shipping) ───────────────────────
# Dashboard: https://one.delhivery.com → account e.g. Domestic ALEGRE B2C
# Token: Settings → API Setup → copy Live API Token (or Request Live API Token)
# Pickup: Settings → Pickup Locations → exact Facility / Location name
# Docs: https://one.delhivery.com/developer-portal/documents/b2c/
# Webhook (after deploy): paste https://YOUR_DOMAIN/api/webhooks/delhivery in Delhivery webhook settings
DELHIVERY_API_TOKEN=
# Staging token uses staging-express host; leave blank to use live track.delhivery.com
# DELHIVERY_API_BASE_URL=https://track.delhivery.com
# DELHIVERY_API_BASE_URL=https://staging-express.delhivery.com
DELHIVERY_PICKUP_NAME=
DELHIVERY_PICKUP_PHONE=
DELHIVERY_PICKUP_PIN=
DELHIVERY_PICKUP_CITY=
DELHIVERY_PICKUP_STATE=
DELHIVERY_PICKUP_ADDRESS=
# Optional — if returns go elsewhere (else pickup address is used)
# DELHIVERY_RETURN_NAME=
# DELHIVERY_RETURN_PHONE=
# DELHIVERY_RETURN_PIN=
# DELHIVERY_RETURN_CITY=
# DELHIVERY_RETURN_STATE=
# DELHIVERY_RETURN_ADDRESS=
# Default parcel (jewellery) — grams + cm
DELHIVERY_DEFAULT_WEIGHT_GMS=300
DELHIVERY_DEFAULT_LENGTH_CM=15
DELHIVERY_DEFAULT_WIDTH_CM=12
DELHIVERY_DEFAULT_HEIGHT_CM=4
# Optional shared secret / header check if Delhivery gives one
# DELHIVERY_WEBHOOK_SECRET=

# ─── Admin bootstrap (used only by seed script) ─────────
# Put your real admin email/password in .env.local only (never commit).
# Then run: npm run seed:admin
ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD=your-strong-admin-password

# Legacy admin cookie signing (admin app still uses this after Supabase role check)
ADMIN_SESSION_SECRET=replace-with-long-random-secret

# ─── Razorpay (existing) ────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Cloudflare R2 (product images + videos) — use R2 S3 Access Key ID + Secret (not cfat_ tokens)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=velvetshell
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
# CLOUDFLARE_R2_ENDPOINT=
